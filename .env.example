# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=job_tracking_db
MYSQL_USER=jobtracker
MYSQL_PASSWORD=jobtracker123

# JWT Configuration
# Generate a secure secret: openssl rand -base64 48
# The value is Base64-decoded before the signing key is derived, and the decoded
# length selects the HMAC variant, so 48 bytes keeps signing on HS384.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Token expiration in milliseconds (default: 30 days = 2592000000)
JWT_EXPIRATION=2592000000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
